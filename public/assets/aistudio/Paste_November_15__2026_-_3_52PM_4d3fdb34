    // =========================================================================
    function detectRelevantMcpTool(userText) {
      const q = userText.toLowerCase();
      const enabledTools = state.tools.filter((t) => t.enabled);
      if (enabledTools.length === 0) return null;

      if (q.includes("hệ thống") || q.includes("server") || q.includes("status") || q.includes("cpu") || q.includes("trạng thái")) {
        return enabledTools.find((t) => t.name === "hermes_get_system_status") || null;
      }
      if (q.includes("nhớ") || q.includes("memory") || q.includes("lịch") || q.includes("ghi chú") || q.includes("tìm")) {
        return enabledTools.find((t) => t.name === "hermes_search_memory") || null;
      }
      if (q.includes("chạy") || q.includes("workflow") || q.includes("tự động") || q.includes("đồng bộ") || q.includes("kích hoạt")) {
        return enabledTools.find((t) => t.name === "hermes_execute_workflow") || null;
      }
      if (q.includes("tài liệu") || q.includes("docs") || q.includes("hermes") || q.includes("mcp")) {
        return enabledTools.find((t) => t.name === "hermes_fetch_docs") || null;
      }
      return null;
    }

    async function callGeminiWithExponentialBackoff(payload, retries = 3) {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${apiKey}`;
      let delay = 1000;

      for (let attempt = 0; attempt <= retries; attempt++) {
        try {
          const response = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });

          if (!response.ok) {
            throw new Error(`HTTP ${response.status}`);
          }
          return await response.json();
        } catch (err) {
          if (attempt === retries) throw err;
          await new Promise((r) => setTimeout(r, delay));
          delay *= 2;
        }
      }
    }

    async function processUserMessage(userText) {
      const cleanText = userText.trim();
      if (!cleanText) return;

      // Stop any ongoing speech synthesis
      if ("speechSynthesis" in window) window.speechSynthesis.cancel();

      state.messages.push({ role: "user", text: cleanText });
      renderTranscript();

      setAppStatus("thinking", "Thinking...");

      // Check if an Hermes MCP tool should be invoked
      let mcpContextBlock = "";
      let mcpCallMeta = null;
      const matchedTool = detectRelevantMcpTool(cleanText);

      if (matchedTool) {
        setAppStatus("thinking", "Hermes MCP...");
        const toolResult = await invokeHermesMcpTool(matchedTool.name, { query: cleanText });
        mcpCallMeta = {
          uri: matchedTool.uri,
          payload: toolResult
        };
        mcpContextBlock = `\n[Dữ liệu vừa truy xuất từ công cụ Hermes MCP (${matchedTool.name})]: ${JSON.stringify(toolResult)}`;
      }

      // Build conversation history for Gemini
      const systemInstruction = {
        parts: [
          {
            text:
              "Bạn là Gemini Live kết nối trực tiếp với Hermes MCP (Model Context Protocol). " +
              "Hãy trả lời ngắn gọn, tự nhiên, thân thiện như đang trò chuyện bằng giọng nói trực tiếp (2-3 câu súc tích, không dùng markdown phức tạp hay ký tự sao *). " +
              "Luôn ưu tiên tiếng Việt tự nhiên (trừ khi người dùng nói tiếng Anh). " +
              "Nếu có dữ liệu từ Hermes MCP đính kèm, hãy lồng ghép thông tin đó một cách tự nhiên vào câu trả lời."
          }
        ]
      };

      const historyContents = state.messages.slice(-8).map((m, idx, arr) => {
        const isLast = idx === arr.length - 1;
        return {
          role: m.role === "user" ? "user" : "model",
          parts: [{ text: isLast ? m.text + mcpContextBlock : m.text }]
        };
      });

      try {
        const result = await callGeminiWithExponentialBackoff({
          contents: historyContents,
          systemInstruction
        });

        const replyText =
          result?.candidates?.[0]?.content?.parts?.[0]?.text?.trim() ||
          "Mình đã nhận được tín hiệu từ Hermes MCP nhưng chưa có nội dung phản hồi cụ thể.";

        state.messages.push({
          role: "gemini",
          text: replyText,
          mcpCall: mcpCallMeta
        });
        renderTranscript();
        speakReply(replyText);
      } catch (error) {
        const fallbackReply = mcpCallMeta
          ? `Mình đã truy vấn ${mcpCallMeta.uri} trên Hermes MCP thành công. Hệ thống đang hoạt động ổn định và sẵn sàng hỗ trợ bạn.`
          : "Kết nối Gemini đang tạm gián đoạn, bạn thử nói lại hoặc kiểm tra mạng nhé.";

        state.messages.push({
          role: "gemini",
          text: fallbackReply,
          mcpCall: mcpCallMeta
        });
        renderTranscript();
        speakReply(fallbackReply);
      }
    }

    // =========================================================================
    // 6. BROWSER SPEECH RECOGNITION & SPEECH SYNTHESIS (VOICE LOOP)
    // =========================================================================
    let recognition = null;
    let audioContext = null;
    let analyser = null;
    let micStream = null;
    let meterAnimId = null;

    function initSpeechRecognition() {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) return null;

      const rec = new SpeechRecognition();
      rec.lang = "vi-VN";
      rec.continuous = true;
      rec.interimResults = true;

      rec.onresult = (event) => {
        let interim = "";
        let finalTranscript = "";

        for (let i = event.resultIndex; i < event.results.length; i++) {
          const transcript = event.results[i][0].transcript;
          if (event.results[i].isFinal) {
            finalTranscript += transcript;
          } else {
            interim += transcript;
          }
        }

        const interimBar = document.getElementById("interimBar");
        const interimText = document.getElementById("interimText");

        if (interim) {
          interimBar.classList.remove("hidden");
          interimText.textContent = interim;
          setAppStatus("listening", "Listening...");
        } else {
          interimBar.classList.add("hidden");
        }

        if (finalTranscript.trim()) {
          interimBar.classList.add("hidden");
          processUserMessage(finalTranscript.trim());
        }
      };

      rec.onerror = (e) => {
        if (e.error === "not-allowed") {
          stopVoiceSession();
          toggleTextInput(true);
        }
      };

      rec.onend = () => {
        if (state.isMicActive) {
          try {
            rec.start();
          } catch (_) {}
        }
      };

      return rec;
    }

    async function startMicAudioMeter() {
      try {
        micStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const source = audioContext.createMediaStreamSource(micStream);
        analyser = audioContext.createAnalyser();
        analyser.fftSize = 256;
        source.connect(analyser);

        const dataArray = new Uint8Array(analyser.frequencyBinCount);
        const updateMeter = () => {
          if (!state.isMicActive) return;
          analyser.getByteFrequencyData(dataArray);
          let sum = 0;
          for (let i = 0; i < dataArray.length; i++) sum += dataArray[i];
          const avg = sum / dataArray.length;
          if (state.status === "listening") {
            state.targetAudioLevel = Math.max(0.16, Math.min(1.15, (avg / 65) + 0.14));
          }
          meterAnimId = requestAnimationFrame(updateMeter);
        };
        updateMeter();
      } catch (_) {
        // Ignore if mic hardware isn't accessible in sandbox
      }
    }

    function stopMicAudioMeter() {
      if (meterAnimId) cancelAnimationFrame(meterAnimId);
      if (micStream) {
        micStream.getTracks().forEach((t) => t.stop());
        micStream = null;
      }
      if (audioContext) {
        audioContext.close().catch(() => {});
        audioContext = null;
      }
    }

    function toggleVoiceSession() {
      if (state.isMicActive) {
        stopVoiceSession();
      } else {
        startVoiceSession();
      }
    }

    function startVoiceSession() {
      state.isMicActive = true;
      const btn = document.getElementById("micToggleBtn");
      btn.classList.add("mic-btn-listening");
      document.getElementById("micIconOn").classList.remove("hidden");
      document.getElementById("micIconOff").classList.add("hidden");

      setAppStatus("listening", "Listening...");
      startMicAudioMeter();

      if (!recognition) recognition = initSpeechRecognition();
      if (recognition) {
        try {
          recognition.start();
        } catch (_) {}
      }
    }

    function stopVoiceSession() {
      state.isMicActive = false;
      const btn = document.getElementById("micToggleBtn");
      btn.classList.remove("mic-btn-listening");
      document.getElementById("interimBar").classList.add("hidden");
      stopMicAudioMeter();

      if (recognition) {
        try {
          recognition.stop();
        } catch (_) {}
      }
      setAppStatus("idle", "Standby");
    }

    function speakReply(text) {
      const voiceSetting = document.getElementById("voiceToggleSelect")?.value || "on";
      if (voiceSetting === "off" || !("speechSynthesis" in window)) {
        setAppStatus("speaking", "Speaking...");
        setTimeout(() => {
          setAppStatus("listening", state.isMicActive ? "Listening..." : "Ready");
        }, Math.min(3500, Math.max(1400, text.length * 45)));
        return;
      }

      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = "vi-VN";
      utterance.rate = 1.04;
      utterance.pitch = 1.02;

      utterance.onstart = () => setAppStatus("speaking", "Speaking...");
      utterance.onend = () => setAppStatus("listening", state.isMicActive ? "Listening..." : "Ready");
      utterance.onerror = () => setAppStatus("listening", state.isMicActive ? "Listening..." : "Ready");

      window.speechSynthesis.speak(utterance);
    }

    // =========================================================================
    // 7. KEYBOARD TEXT INPUT & SESSION HELPERS
    // =========================================================================
    function toggleTextInput(forceShow) {
      const form = document.getElementById("textInputForm");
      const input = document.getElementById("chatTextInput");
      const shouldShow = typeof forceShow === "boolean" ? forceShow : form.classList.contains("hidden");

      if (shouldShow) {
        form.classList.remove("hidden");
        input.focus();
      } else {
        form.classList.add("hidden");
      }
    }

    function handleTextSubmit(event) {
      event.preventDefault();
      const input = document.getElementById("chatTextInput");
      const val = input.value.trim();
      if (!val) return;
      input.value = "";
      processUserMessage(val);
    }

    function resetConversation() {
      if ("speechSynthesis" in window) window.speechSynthesis.cancel();
      state.messages = [
        {
          role: "gemini",
          text: "Chào bạn! Mình là Gemini Live đã kết nối với Hermes MCP. Bạn muốn trò chuyện hay kiểm tra ngữ cảnh từ Hermes?",
          mcpCall: {
            uri: "hermes://session/initialize",
            payload: { protocolVersion: "2025-03-26", server: "Hermes MCP Bridge", status: "ready" }
          }
        }
      ];
      renderTranscript();
      toggleMcpDrawer(false);
    }

    // =========================================================================
    // 8. BOOTSTRAP APPLICATION
    // =========================================================================
    window.addEventListener("load", () => {
      resizeWaveCanvas();
      renderWaveform();
      renderMcpTools();

      // Seed initial welcome transcript & MCP handshake log
      logMcpTraffic("REQ →", { jsonrpc: "2.0", id: "init-1", method: "initialize", params: { clientInfo: { name: "Gemini-Live-Web", version: "1.0" } } });
      logMcpTraffic("RES ←", { jsonrpc: "2.0", id: "init-1", result: { serverInfo: { name: "Hermes-MCP", version: "2.4.0" }, capabilities: { tools: true, resources: true } } });

      state.messages = [
        {
          role: "gemini",
          text: "Xin chào! Gemini Live đã sẵn sàng và kết nối với Hermes MCP. Nhấn nút Micro bên dưới để nói chuyện hoặc mở bàn phím để nhắn tin nhé.",
          mcpCall: {
            uri: "hermes://session/initialize",
            payload: { bridge: "Hermes MCP", transport: "JSON-RPC 2.0", tools_loaded: 4 }
          }
        }
      ];
      renderTranscript();
      setAppStatus("listening", "Listening...");
    });
  </script>
</body>

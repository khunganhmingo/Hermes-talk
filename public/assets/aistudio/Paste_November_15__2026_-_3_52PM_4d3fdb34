<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Gemini Live — Hermes MCP Assistant</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-deep: #0B0D14;
      --cyan-glow: #38BDF8;
      --indigo-glow: #6366F1;
      --purple-glow: #A855F7;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: #06080D;
      color: #F8FAFC;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow-x: hidden;
      min-height: 100dvh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Ambient background glow */
    .ambient-bg {
      position: fixed;
      inset: 0;
      background: 
        radial-gradient(circle at 25% 20%, rgba(56, 189, 248, 0.08) 0%, transparent 45%),
        radial-gradient(circle at 75% 75%, rgba(168, 85, 247, 0.09) 0%, transparent 50%),
        #06080D;
      z-index: 0;
      pointer-events: none;
    }

    /* Main responsive container mimicking sleek mobile/desktop card */
    .app-shell {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 480px;
      height: 100dvh;
      background: linear-gradient(180deg, #0D1019 0%, #0B0D14 55%, #090B11 100%);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    @media (min-width: 640px) {
      .app-shell {
        height: min(880px, 94dvh);
        border-radius: 36px;
        border: 1px solid rgba(255, 255, 255, 0.09);
        box-shadow: 
          0 25px 70px -15px rgba(0, 0, 0, 0.85),
          0 0 40px rgba(99, 102, 241, 0.08),
          inset 0 1px 0 rgba(255, 255, 255, 0.08);
      }
    }

    /* Gradient Gemini Text */
    .gemini-gradient-text {
      background: linear-gradient(90deg, #60A5FA 0%, #A78BFA 55%, #E879F9 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* Live Pill Border */
    .live-badge {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(167, 139, 250, 0.45);
      box-shadow: 0 0 12px rgba(168, 85, 247, 0.15);
    }

    /* Status Pill */
    .status-pill {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(12px);
    }

    /* Dual Avatar Rings */
    .avatar-ring-user {
      background: linear-gradient(135deg, #38BDF8, #818CF8, #C084FC);
      padding: 2.5px;
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 0 22px rgba(56, 189, 248, 0.28);
    }

    .avatar-ring-user.active {
      transform: scale(1.07);
      box-shadow: 0 0 34px rgba(56, 189, 248, 0.65), 0 0 12px rgba(192, 132, 252, 0.5);
    }

    .avatar-ring-gemini {
      background: linear-gradient(135deg, #38BDF8, #6366F1, #A855F7);
      padding: 2.5px;
      transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 0 22px rgba(168, 85, 247, 0.28);
    }

    .avatar-ring-gemini.active {
      transform: scale(1.07);
      box-shadow: 0 0 36px rgba(168, 85, 247, 0.7), 0 0 15px rgba(56, 189, 248, 0.55);
    }

    /* Glassmorphic Chat Bubbles */
    .bubble-user {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(10px);
    }

    .bubble-gemini {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.11) 0%, rgba(168, 85, 247, 0.08) 100%);
      border: 1px solid rgba(139, 92, 246, 0.18);
      backdrop-filter: blur(10px);
    }

    /* Custom Scrollbar for Transcript */
    .transcript-scroll::-webkit-scrollbar {
      width: 4px;
    }
    .transcript-scroll::-webkit-scrollbar-track {
      background: transparent;
    }
    .transcript-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
    }

    /* Mic Button Pulse */
    @keyframes micPulse {
      0%, 100% {
        box-shadow: 0 0 0 0 rgba(56, 189, 248, 0.45), 0 0 24px rgba(168, 85, 247, 0.35);
      }
      50% {
        box-shadow: 0 0 0 14px rgba(56, 189, 248, 0), 0 0 32px rgba(168, 85, 247, 0.6);
      }
    }

    .mic-btn-listening {
      animation: micPulse 2s infinite;
      background: linear-gradient(135deg, rgba(56, 189, 248, 0.28), rgba(168, 85, 247, 0.32));
      border-color: rgba(56, 189, 248, 0.7);
    }

    /* Soundwave dots in status pill */
    @keyframes eqDot {
      0%, 100% { transform: scaleY(0.45); opacity: 0.6; }
      50% { transform: scaleY(1.2); opacity: 1; }
    }
    .eq-bar {
      animation: eqDot 0.9s ease-in-out infinite;
    }
    .eq-bar:nth-child(2) { animation-delay: 0.15s; }
    .eq-bar:nth-child(3) { animation-delay: 0.3s; }
    .eq-bar:nth-child(4) { animation-delay: 0.45s; }

    /* Slide-over Drawer */
    .drawer-backdrop {
      background: rgba(5, 7, 12, 0.75);
      backdrop-filter: blur(6px);
      transition: opacity 0.25s ease;
    }
    .drawer-panel {
      background: #0E111B;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .font-mono-code {
      font-family: 'JetBrains Mono', monospace;
    }
  </style>
</head>
<body>
  <div class="ambient-bg"></div>

  <div class="app-shell" id="appShell">
    <!-- Top Header -->
    <header class="flex items-center justify-between px-5 pt-5 pb-2 shrink-0">
      <div class="flex items-center gap-2">
        <!-- Gemini Brand -->
        <div class="flex items-center gap-1.5">
          <svg class="w-5 h-5 text-sky-400" viewBox="0 0 24 24" fill="none">
            <path d="M12 2C12.3 7.4 16.6 11.7 22 12C16.6 12.3 12.3 16.6 12 22C11.7 16.6 7.4 12.3 2 12C7.4 11.7 11.7 7.4 12 2Z" fill="url(#geminiSpark)"/>
            <defs>
              <linearGradient id="geminiSpark" x1="2" y1="2" x2="22" y2="22" gradientUnits="userSpaceOnUse">
                <stop stop-color="#38BDF8"/>
                <stop offset="0.5" stop-color="#818CF8"/>
                <stop offset="1" stop-color="#C084FC"/>
              </linearGradient>
            </defs>
          </svg>
          <span class="text-[21px] font-semibold tracking-tight gemini-gradient-text">Gemini</span>
        </div>

        <!-- Live Badge -->
        <span class="live-badge text-[11px] font-medium text-purple-200 px-2.5 py-0.5 rounded-full tracking-wide">
          Live
        </span>

        <!-- Hermes MCP Connection Badge -->
        <button id="headerMcpBtn" onclick="toggleMcpDrawer(true)" title="Cấu hình kết nối Hermes MCP"
          class="flex items-center gap-1.5 bg-white/[0.04] hover:bg-white/[0.08] border border-cyan-500/25 rounded-full px-2.5 py-0.5 transition cursor-pointer">
          <span id="mcpHeaderDot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_#34D399]"></span>
          <span class="text-[10.5px] font-medium text-cyan-200/90 tracking-tight">Hermes MCP</span>
        </button>
      </div>

      <!-- Right Status Pill -->
      <div class="flex items-center gap-2">
        <div id="statusPill" class="status-pill flex items-center gap-2 px-3 py-1.5 rounded-full">
          <div class="flex items-center gap-[2px] h-3" id="statusEq">
            <span class="eq-bar w-[2px] h-2 bg-sky-400 rounded-full"></span>
            <span class="eq-bar w-[2px] h-3 bg-indigo-400 rounded-full"></span>
            <span class="eq-bar w-[2px] h-2.5 bg-purple-400 rounded-full"></span>
            <span class="eq-bar w-[2px] h-1.5 bg-sky-300 rounded-full"></span>
          </div>
          <span id="statusText" class="text-[12px] font-medium text-slate-200 tracking-tight">Listening...</span>
        </div>
      </div>
    </header>

    <!-- Centerpiece Waveform Visualizer -->
    <section class="relative w-full h-44 sm:h-48 shrink-0 flex items-center justify-center overflow-hidden select-none">
      <canvas id="waveCanvas" class="w-full h-full block"></canvas>
    </section>

    <!-- Dual Avatars Row -->
    <section class="flex items-center justify-center gap-10 sm:gap-12 pb-4 shrink-0">
      <!-- User Avatar -->
      <div class="flex flex-col items-center gap-2">
        <div id="userAvatarRing" class="avatar-ring-user w-[70px] h-[70px] rounded-full flex items-center justify-center">
          <div class="w-full h-full rounded-full bg-[#131826] flex items-center justify-center overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-tr from-sky-500/20 via-indigo-500/15 to-amber-200/20"></div>
            <svg class="w-9 h-9 text-slate-200/90 relative z-10 mt-1" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.33 0-10 1.67-10 5v2h20v-2c0-3.33-6.67-5-10-5z"/>
            </svg>
          </div>
        </div>
        <span class="text-[12.5px] font-medium text-slate-300 tracking-wide">User</span>
      </div>

      <!-- Gemini Avatar -->
      <div class="flex flex-col items-center gap-2">
        <div id="geminiAvatarRing" class="avatar-ring-gemini w-[70px] h-[70px] rounded-full flex items-center justify-center">
          <div class="w-full h-full rounded-full bg-[#101420] flex items-center justify-center relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-br from-sky-500/15 via-indigo-600/20 to-purple-600/25"></div>
            <svg class="w-9 h-9 relative z-10" viewBox="0 0 24 24" fill="none">
              <path d="M12 2.5C12.35 7.6 16.4 11.65 21.5 12C16.4 12.35 12.35 16.4 12 21.5C11.65 16.4 7.6 12.35 2.5 12C7.6 11.65 11.65 7.6 12 2.5Z" fill="url(#avatarStarGrad)"/>
              <defs>
                <linearGradient id="avatarStarGrad" x1="2.5" y1="2.5" x2="21.5" y2="21.5" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#60A5FA"/>
                  <stop offset="0.5" stop-color="#818CF8"/>
                  <stop offset="1" stop-color="#C084FC"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
        </div>
        <span class="text-[12.5px] font-medium text-slate-300 tracking-wide">Gemini</span>
      </div>
    </section>

    <!-- Live Transcript / Chat Feed -->
    <main id="transcriptContainer" class="transcript-scroll flex-1 overflow-y-auto px-5 py-2 space-y-3 flex flex-col">
      <!-- Messages injected here dynamically -->
    </main>

    <!-- Live Interim Speech Caption -->
    <div id="interimBar" class="hidden px-5 py-1.5 text-center">
      <span id="interimText" class="inline-block text-xs text-sky-300/90 bg-sky-950/50 border border-sky-500/25 rounded-full px-3 py-1 italic truncate max-w-full"></span>
    </div>

    <!-- Optional Text Input Drawer Bar -->
    <form id="textInputForm" onsubmit="handleTextSubmit(event)" class="hidden px-4 pt-2 pb-1 shrink-0">
      <div class="flex items-center gap-2 bg-white/[0.06] border border-white/15 rounded-full px-3.5 py-1.5 focus-within:border-sky-400/60 transition">
        <input id="chatTextInput" type="text" autocomplete="off"
          placeholder="Nhập tin nhắn hoặc lệnh Hermes MCP..."
          class="flex-1 bg-transparent text-sm text-white placeholder-slate-400 focus:outline-none py-1" />
        <button type="submit"
          class="p-2 rounded-full bg-gradient-to-r from-sky-500 to-purple-500 text-white hover:opacity-90 transition cursor-pointer shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </form>

    <!-- Bottom Controls -->
    <footer class="px-6 pt-3 pb-6 shrink-0 flex items-center justify-center gap-6">
      <!-- Keyboard Toggle -->
      <button id="toggleKeyboardBtn" onclick="toggleTextInput()" title="Nhập văn bản"
        class="w-11 h-11 rounded-full bg-white/[0.06] hover:bg-white/[0.12] border border-white/10 flex items-center justify-center text-slate-300 transition cursor-pointer">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <rect x="2" y="5" width="20" height="14" rx="3"/>
          <path d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M6 13h.01M10 13h.01M14 13h.01M18 13h.01M8 16h8" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Central Glowing Microphone Button -->
      <button id="micToggleBtn" onclick="toggleVoiceSession()" title="Bật / Tắt micro trò chuyện"
        class="w-16 h-16 rounded-full bg-white/[0.08] hover:bg-white/[0.13] border border-white/20 flex items-center justify-center text-white shadow-lg transition-all duration-300 cursor-pointer relative">
        <svg id="micIconOn" class="w-6 h-6 text-slate-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="2" width="6" height="12" rx="3"/>
          <path d="M5 10a7 7 0 0 0 14 0M12 19v3M8 22h8" stroke-linecap="round"/>
        </svg>
        <svg id="micIconOff" class="w-6 h-6 text-rose-400 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="2" y1="2" x2="22" y2="22" stroke-linecap="round"/>
          <path d="M18.89 13.23A7.12 7.12 0 0 0 19 12v-2M5 10v2a7 7 0 0 0 12 5M15 9.34V5a3 3 0 0 0-5.68-1.33M9 9v3a3 3 0 0 0 5.12 2.12M12 19v3M8 22h8" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Hermes MCP Inspector & Settings Button -->
      <button onclick="toggleMcpDrawer(true)" title="Hermes MCP Server & Logs"
        class="w-11 h-11 rounded-full bg-white/[0.06] hover:bg-white/[0.12] border border-white/10 flex items-center justify-center text-cyan-300 transition cursor-pointer relative">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 12l8-4.5M12 12v9M12 12L4 7.5"/>
        </svg>
        <span id="mcpBadgeCount" class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-sky-500 text-[10px] font-bold text-slate-950 flex items-center justify-center">4</span>
      </button>
    </footer>

    <!-- Hermes MCP Configuration & JSON-RPC Drawer -->
    <div id="mcpDrawer" class="hidden absolute inset-0 z-50 flex flex-col justify-end">
      <div class="drawer-backdrop absolute inset-0" onclick="toggleMcpDrawer(false)"></div>
      <div class="drawer-panel relative z-10 rounded-t-3xl max-h-[86%] flex flex-col overflow-hidden shadow-2xl">
        <!-- Drawer Handle & Title -->
        <div class="px-5 pt-3 pb-3 border-b border-white/10 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-sky-500/20 to-purple-500/20 border border-sky-400/30 flex items-center justify-center text-sky-300">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-sm font-semibold text-white">Hermes MCP Bridge</h2>
              <p class="text-[11px] text-slate-400">Model Context Protocol • JSON-RPC 2.0</p>
            </div>
          </div>
          <button onclick="toggleMcpDrawer(false)" class="p-2 rounded-full hover:bg-white/10 text-slate-400 hover:text-white cursor-pointer">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>

        <!-- Drawer Body -->
        <div class="p-5 overflow-y-auto space-y-5 transcript-scroll text-xs">
          <!-- Connection Config -->
          <div class="space-y-3 bg-white/[0.03] border border-white/10 rounded-2xl p-3.5">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-slate-200">Hermes Server Endpoint</span>
              <span id="mcpConnStateLabel" class="px-2 py-0.5 rounded-full text-[10.5px] font-medium bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                Hybrid Ready (Auto-Fallback)
              </span>
            </div>

            <div class="space-y-2">
              <label class="block text-[11px] text-slate-400">MCP HTTP / SSE Endpoint URL</label>
              <div class="flex gap-2">
                <input id="mcpEndpointInput" type="text" value="http://localhost:8080/mcp"
                  class="flex-1 bg-black/40 border border-white/15 rounded-xl px-3 py-2 text-slate-200 font-mono-code text-[11px] focus:outline-none focus:border-sky-400" />
                <button onclick="pingHermesMcp()"
                  class="px-3 py-2 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 border border-sky-400/40 text-sky-300 font-medium transition cursor-pointer shrink-0">
                  Ping MCP
                </button>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 pt-1">
              <div>
                <label class="block text-[11px] text-slate-400 mb-1">Bearer Token (Tùy chọn)</label>
                <input id="mcpTokenInput" type="password" placeholder="hermes_sk_..."
                  class="w-full bg-black/40 border border-white/15 rounded-xl px-3 py-1.5 text-slate-200 font-mono-code text-[11px] focus:outline-none focus:border-sky-400" />
              </div>
              <div>
                <label class="block text-[11px] text-slate-400 mb-1">Giọng đọc AI (TTS)</label>
                <select id="voiceToggleSelect" class="w-full bg-black/40 border border-white/15 rounded-xl px-2.5 py-1.5 text-slate-200 text-[11px] focus:outline-none focus:border-sky-400">
                  <option value="on">Bật giọng đọc (Tiếng Việt)</option>
                  <option value="off">Chỉ hiển thị văn bản</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Available MCP Tools -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-slate-200">Hermes MCP Tools (<span id="activeToolCount">4</span> active)</span>
              <button onclick="resetConversation()" class="text-[11px] text-rose-400 hover:underline cursor-pointer">
                Xóa lịch sử chat
              </button>
            </div>
            <div id="mcpToolsList" class="grid grid-cols-1 gap-2">
              <!-- Populated by JS -->
            </div>
          </div>

          <!-- JSON-RPC 2.0 Live Traffic Inspector -->
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-semibold text-slate-200">JSON-RPC 2.0 MCP Traffic Log</span>
              <button onclick="clearMcpLogs()" class="text-[11px] text-slate-400 hover:text-white cursor-pointer">Clear</button>
            </div>
            <div id="mcpLogViewer" class="bg-black/60 border border-white/10 rounded-xl p-3 font-mono-code text-[10.5px] text-cyan-200/90 max-h-40 overflow-y-auto space-y-2 transcript-scroll">
              <!-- Logs injected here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // =========================================================================
    // 1. STATE & CONFIGURATION
    // =========================================================================
    const apiKey = ""; // Runtime-provided Gemini API Key
    const GEMINI_MODEL = "gemini-3-flash-preview";

    const state = {
      status: "listening", // 'idle' | 'listening' | 'thinking' | 'speaking'
      isMicActive: false,
      audioLevel: 0.08,
      targetAudioLevel: 0.08,
      mcpEndpoint: "http://localhost:8080/mcp",
      mcpToken: "",
      mcpConnectedMode: "hybrid", // 'live' | 'hybrid'
      tools: [
        {
          name: "hermes_search_memory",
          uri: "hermes://memory/semantic_search",
          description: "Truy xuất trí nhớ ngữ cảnh, ghi chú và tri thức cá nhân trên Hermes Server.",
          enabled: true
        },
        {
          name: "hermes_get_system_status",
          uri: "hermes://telemetry/cluster_health",
          description: "Kiểm tra trạng thái dịch vụ, CPU/RAM, uptime và các MCP worker đang chạy.",
          enabled: true
        },
        {
          name: "hermes_execute_workflow",
          uri: "hermes://workflows/trigger",
          description: "Kích hoạt quy trình tự động hóa (tổng hợp báo cáo, đồng bộ tác vụ, webhook).",
          enabled: true
        },
        {
          name: "hermes_fetch_docs",
          uri: "hermes://resources/knowledge_base",
          description: "Đọc tài liệu kỹ thuật, API spec và hướng dẫn nội bộ từ kho Hermes.",
          enabled: true
        }
      ],
      messages: [],
      mcpLogs: []
    };

    // =========================================================================
    // 2. WAVEFORM VISUALIZER (MULTI-LAYERED GLOWING SINE WAVES)
    // =========================================================================
    const canvas = document.getElementById("waveCanvas");
    const ctx = canvas.getContext("2d");
    let wavePhase = 0;

    function resizeWaveCanvas() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      canvas.width = rect.width * dpr;
      canvas.height = rect.height * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    window.addEventListener("resize", resizeWaveCanvas);

    function renderWaveform() {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      const centerY = height / 2;

      ctx.clearRect(0, 0, width, height);

      // Smooth audio level interpolation
      if (state.status === "speaking") {
        state.targetAudioLevel = 0.55 + Math.sin(wavePhase * 2.3) * 0.25 + Math.random() * 0.18;
      } else if (state.status === "thinking") {
        state.targetAudioLevel = 0.32 + Math.sin(wavePhase * 1.5) * 0.1;
      } else if (!state.isMicActive) {
        state.targetAudioLevel = 0.16 + Math.sin(wavePhase * 0.7) * 0.04;
      }
      state.audioLevel += (state.targetAudioLevel - state.audioLevel) * 0.14;

      const maxAmp = (height * 0.36) * Math.min(1.25, state.audioLevel * 1.65);

      // Layered waves inspired by Gemini Live glowing cyan/purple ribbon
      const layers = [
        { freq: 1.6, speed: 0.045, ampScale: 1.0,  phaseOffset: 0.0,  alpha: 0.95, lineWidth: 2.2, fillAlpha: 0.22 },
        { freq: 2.2, speed: -0.035, ampScale: 0.78, phaseOffset: 1.4, alpha: 0.75, lineWidth: 1.7, fillAlpha: 0.14 },
        { freq: 1.2, speed: 0.028, ampScale: 0.62, phaseOffset: 2.7,  alpha: 0.55, lineWidth: 1.3, fillAlpha: 0.10 }
      ];

      layers.forEach((layer, idx) => {
        const strokeGrad = ctx.createLinearGradient(0, centerY, width, centerY);
        strokeGrad.addColorStop(0.0, "rgba(56, 189, 248, 0.05)");
        strokeGrad.addColorStop(0.22, `rgba(56, 189, 248, ${layer.alpha})`);
        strokeGrad.addColorStop(0.5, `rgba(99, 102, 241, ${layer.alpha})`);
        strokeGrad.addColorStop(0.78, `rgba(168, 85, 247, ${layer.alpha})`);
        strokeGrad.addColorStop(1.0, "rgba(168, 85, 247, 0.05)");

        const fillGrad = ctx.createLinearGradient(0, centerY - maxAmp, 0, centerY + maxAmp);
        fillGrad.addColorStop(0, `rgba(56, 189, 248, ${layer.fillAlpha})`);
        fillGrad.addColorStop(0.5, `rgba(99, 102, 241, ${layer.fillAlpha * 1.2})`);
        fillGrad.addColorStop(1, `rgba(168, 85, 247, ${layer.fillAlpha})`);

        const pointsTop = [];
        const pointsBottom = [];
        const step = 3;

        for (let x = 0; x <= width; x += step) {
          const normX = (x / width) * 2 - 1; // -1 to 1
          // Bell-curve envelope tapering smoothly to 0 at edges
          const envelope = Math.pow(Math.max(0, 1 - normX * normX), 2.3);
          const wave1 = Math.sin(normX * Math.PI * layer.freq + wavePhase * (idx % 2 === 0 ? 1 : -0.85) + layer.phaseOffset);
          const wave2 = Math.cos(normX * Math.PI * (layer.freq * 1.7) - wavePhase * 0.7);
          const yOffset = envelope * maxAmp * layer.ampScale * (0.68 * wave1 + 0.32 * wave2);

          pointsTop.push({ x, y: centerY - Math.abs(yOffset) - envelope * 2 });
          pointsBottom.push({ x, y: centerY + Math.abs(yOffset) + envelope * 2 });
        }

        // Draw symmetric glowing ribbon body
        ctx.save();
        ctx.beginPath();
        pointsTop.forEach((pt, i) => (i === 0 ? ctx.moveTo(pt.x, pt.y) : ctx.lineTo(pt.x, pt.y)));
        for (let i = pointsBottom.length - 1; i >= 0; i--) {
          ctx.lineTo(pointsBottom[i].x, pointsBottom[i].y);
        }
        ctx.closePath();
        ctx.fillStyle = fillGrad;
        ctx.fill();

        // Draw upper & lower neon strokes with subtle glow
        ctx.shadowBlur = idx === 0 ? 14 : 6;
        ctx.shadowColor = idx === 0 ? "rgba(56, 189, 248, 0.65)" : "rgba(168, 85, 247, 0.45)";
        ctx.strokeStyle = strokeGrad;
        ctx.lineWidth = layer.lineWidth;

        ctx.beginPath();
        pointsTop.forEach((pt, i) => (i === 0 ? ctx.moveTo(pt.x, pt.y) : ctx.lineTo(pt.x, pt.y)));
        ctx.stroke();

        ctx.beginPath();
        pointsBottom.forEach((pt, i) => (i === 0 ? ctx.moveTo(pt.x, pt.y) : ctx.lineTo(pt.x, pt.y)));
        ctx.stroke();
        ctx.restore();
      });

      wavePhase += state.status === "speaking" ? 0.085 : (state.status === "thinking" ? 0.065 : 0.038);
      requestAnimationFrame(renderWaveform);
    }


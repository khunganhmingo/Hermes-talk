    async function invokeHermesMcpTool(toolName, args = {}) {
      const rpcRequest = {
        jsonrpc: "2.0",
        id: `mcp-${Date.now()}`,
        method: "tools/call",
        params: {
          name: toolName,
          arguments: args
        }
      };

      logMcpTraffic("REQ →", rpcRequest);

      // Attempt real HTTP JSON-RPC call to configured Hermes MCP endpoint
      const endpoint = document.getElementById("mcpEndpointInput")?.value.trim() || state.mcpEndpoint;
      const token = document.getElementById("mcpTokenInput")?.value.trim() || state.mcpToken;

      try {
        const controller = new AbortController();
        const timeoutId = setTimeout(() => controller.abort(), 1600);

        const headers = { "Content-Type": "application/json" };
        if (token) headers["Authorization"] = `Bearer ${token}`;

        const res = await fetch(endpoint, {
          method: "POST",
          headers,
          body: JSON.stringify(rpcRequest),
          signal: controller.signal
        });
        clearTimeout(timeoutId);

        if (res.ok) {
          const data = await res.json();
          state.mcpConnectedMode = "live";
          updateMcpStatusUI(true);
          logMcpTraffic("RES ←", data);
          return data.result || data;
        }
      } catch (_) {
        // Graceful fallback to simulated Hermes MCP response when localhost server is unreachable
      }

      // Simulated Hermes MCP Server response
      state.mcpConnectedMode = "hybrid";
      const simulatedData = buildSimulatedHermesResponse(toolName, args);
      const rpcResponse = {
        jsonrpc: "2.0",
        id: rpcRequest.id,
        result: {
          content: [{ type: "text", text: JSON.stringify(simulatedData) }],
          isError: false,
          source: "hermes-mcp-bridge"
        }
      };
      logMcpTraffic("RES ←", rpcResponse);
      return simulatedData;
    }

    function buildSimulatedHermesResponse(toolName, args) {
      const now = new Date().toLocaleString("vi-VN");
      switch (toolName) {
        case "hermes_get_system_status":
          return {
            cluster: "hermes-core-01",
            status: "HEALTHY",
            uptime: "14d 08h 42m",
            cpu_load: "23.4%",
            memory_usage: "4.2 GB / 16 GB",
            active_mcp_sessions: 3,
            timestamp: now
          };
        case "hermes_search_memory":
          return {
            query: args.query || "ngữ cảnh gần đây",
            matches: [
              { id: "mem_901", topic: "Kiến trúc Hermes MCP", summary: "Kết nối song công JSON-RPC 2.0 với Gemini Live để truy xuất ngữ cảnh thời gian thực." },
              { id: "mem_904", topic: "Lịch trình hôm nay", summary: "16:00 Họp đồng bộ API Gateway & kiểm thử luồng thoại." }
            ]
          };
        case "hermes_execute_workflow":
          return {
            workflow: args.workflow_name || "daily_sync_pipeline",
            execution_id: "wf_" + Math.floor(100000 + Math.random() * 900000),
            state: "COMPLETED",
            duration_ms: 340
          };
        case "hermes_fetch_docs":
        default:
          return {
            resource: "hermes://docs/mcp-spec-v1",
            title: "Tài liệu giao thức Hermes MCP",
            excerpt: "Hermes hỗ trợ các phương thức chuẩn: initialize, tools/list, tools/call và resources/read qua HTTP/SSE."
          };
      }
    }

    async function pingHermesMcp() {
      const pingPayload = { jsonrpc: "2.0", id: `ping-${Date.now()}`, method: "tools/list", params: {} };
      logMcpTraffic("REQ →", pingPayload);

      const endpoint = document.getElementById("mcpEndpointInput").value.trim();

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'taiphanmemtot@gmail.com';
    }

    function isAdmin() {
      return isBootstrapAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPermissionsList(perms) {
      return perms is list
        && perms.size() <= 10
        && perms.hasOnly(['voice_live', 'text_chat', 'hermes_mcp', 'tts_preview']);
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll([
          'id', 'email', 'displayName', 'photoURL', 'role', 'status',
          'permissions', 'expiresAtMs', 'note', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && data.keys().hasOnly([
          'id', 'email', 'displayName', 'photoURL', 'role', 'status',
          'permissions', 'expiresAtMs', 'note', 'createdAt', 'updatedAt', 'lastLoginAt'
        ])
        && isValidId(data.id)
        && data.id == userId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.photoURL is string && data.photoURL.size() <= 500
        && data.role in ['admin', 'user']
        && data.status in ['active', 'locked']
        && isValidPermissionsList(data.permissions)
        && data.expiresAtMs is number && data.expiresAtMs >= 0
        && data.note is string && data.note.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidUserInvite(data, inviteId) {
      return data.keys().hasAll([
          'id', 'email', 'displayName', 'role', 'status',
          'permissions', 'expiresAtMs', 'note', 'claimedUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'email', 'displayName', 'role', 'status',
          'permissions', 'expiresAtMs', 'note', 'claimedUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.id == inviteId
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.role in ['admin', 'user']
        && data.status in ['active', 'locked']
        && isValidPermissionsList(data.permissions)
        && data.expiresAtMs is number && data.expiresAtMs >= 0
        && data.note is string && data.note.size() <= 500
        && data.claimedUid is string && data.claimedUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'addedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'addedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == adminUid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.addedBy is string && data.addedBy.size() >= 1 && data.addedBy.size() <= 128
        && data.createdAt is timestamp;
    }

    function isValidActivityLog(data, logId) {
      return data.keys().hasAll([
          'id', 'actorUid', 'actorEmail', 'actorRole', 'action',
          'targetId', 'targetLabel', 'detail', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'actorUid', 'actorEmail', 'actorRole', 'action',
          'targetId', 'targetLabel', 'detail', 'createdAt'
        ])
        && isValidId(data.id)
        && data.id == logId
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 160
        && data.actorRole in ['admin', 'user']
        && data.action in [
          'login', 'logout', 'create_user', 'update_user',
          'lock_user', 'unlock_user', 'extend_user', 'delete_user',
          'auto_expire_lock', 'update_profile',
          'use_voice_live', 'use_text_chat', 'use_hermes_mcp', 'use_tts_preview'
        ]
        && data.targetId is string && data.targetId.size() <= 128
        && data.targetLabel is string && data.targetLabel.size() <= 160
        && data.detail is string && data.detail.size() >= 1 && data.detail.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidSession(data, userId, sessionId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'updatedAt'])
        && isValidId(data.id)
        && data.id == sessionId
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    function emailInviteKey() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    match /users/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.id == request.auth.uid);

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().lastLoginAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().email.lower() == request.auth.token.email.lower()
            && (
              (isBootstrapAdmin() && incoming().role == 'admin' && incoming().status == 'active') ||
              (
                exists(/databases/$(database)/documents/userInvites/$(emailInviteKey()))
                && incoming().role == get(/databases/$(database)/documents/userInvites/$(emailInviteKey())).data.role
                && incoming().status == get(/databases/$(database)/documents/userInvites/$(emailInviteKey())).data.status
                && incoming().permissions == get(/databases/$(database)/documents/userInvites/$(emailInviteKey())).data.permissions
                && incoming().expiresAtMs == get(/databases/$(database)/documents/userInvites/$(emailInviteKey())).data.expiresAtMs
              ) ||
              (
                !exists(/databases/$(database)/documents/userInvites/$(emailInviteKey()))
                && incoming().role == 'user'
                && incoming().status == 'active'
                && incoming().expiresAtMs > request.time.toMillis()
                && incoming().expiresAtMs <= request.time.toMillis() + 2678400000
              )
            )
          )
        );

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) && (
              (
                incoming().role == existing().role
                && incoming().status == existing().status
                && incoming().permissions == existing().permissions
                && incoming().expiresAtMs == existing().expiresAtMs
                && incoming().note == existing().note
                && incoming().email == existing().email
                && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt', 'updatedAt'])
              ) ||
              (
                existing().status == 'active'
                && existing().expiresAtMs > 0
                && request.time.toMillis() >= existing().expiresAtMs
                && incoming().status == 'locked'
                && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(userId) && userId != request.auth.uid;

      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
        allow create: if isOwner(userId)
          && isValidId(sessionId)
          && isValidSession(incoming(), userId, sessionId);
        allow update: if isOwner(userId)
          && isValidId(sessionId)
          && isValidSession(incoming(), userId, sessionId)
          && incoming().id == existing().id
          && incoming().userId == existing().userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }

    match /userInvites/{inviteId} {
      allow get: if (isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email)) && isValidId(inviteId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.email == request.auth.token.email);
      allow create: if isAdmin()
        && isValidId(inviteId)
        && isValidUserInvite(incoming(), inviteId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidId(inviteId)
        && isValidUserInvite(incoming(), inviteId)
        && incoming().id == existing().id
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().email == request.auth.token.email
            && existing().claimedUid == ''
            && incoming().claimedUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['claimedUid', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(inviteId);
    }

    match /admins/{adminUid} {
      allow get: if (isAdmin() || isOwner(adminUid)) && isValidId(adminUid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminGrant(incoming(), adminUid)
        && incoming().addedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid) && adminUid != request.auth.uid;
    }

    match /activityLogs/{logId} {
      allow get: if (isAdmin() || (isSignedIn() && resource.data.actorUid == request.auth.uid)) && isValidId(logId);
      allow list: if isAdmin() || (isSignedIn() && resource.data.actorUid == request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(logId)
        && isValidActivityLog(incoming(), logId)
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}

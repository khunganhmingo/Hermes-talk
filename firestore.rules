rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidSession(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'updatedAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'updatedAt'])
        && isValidId(data.id)
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 40;
    }

    match /users/{userId}/sessions/{sessionId} {
      allow get: if isOwner(userId) && isValidId(sessionId);
      allow list: if isOwner(userId) && resource.data.userId == request.auth.uid;
      allow create: if isOwner(userId)
        && isValidId(sessionId)
        && isValidSession(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidId(sessionId)
        && isValidSession(incoming(), userId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(sessionId);
    }
  }
}
